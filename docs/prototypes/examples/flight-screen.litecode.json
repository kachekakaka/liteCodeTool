{
  "format": "litecode.screen.v1",
  "screen": {
    "bindingVersion": 2,
    "id": "screen_flight",
    "name": "高度与速度监控示例",
    "resolution": { "width": 1920, "height": 1080 },
    "background": "#030B17",
    "components": [
      {
        "instanceId": "instance_flight",
        "templateId": "tpl_flight",
        "position": { "x": 20, "y": 20, "w": 600, "h": 360, "zIndex": 1 },
        "slotBindings": { "target1": "P-101" },
        "slotSourceBindings": { "target1": "雷达2" },
        "controlOverrides": {}
      }
    ]
  },
  "templates": [
    {
      "id": "tpl_flight",
      "name": "高度与速度",
      "category": "对接示例",
      "layout": { "width": 600, "height": 300 },
      "slots": [{ "id": "target1", "label": "飞行目标", "schemaType": "projectile" }],
      "controls": [
        {
          "id": "height_value",
          "type": "number",
          "style": { "x": 10, "y": 10, "w": 180, "h": 60 },
          "props": {
            "sourceMode": "dynamic",
            "labelMode": "auto",
            "unitMode": "auto",
            "precision": 2
          },
          "binding": { "target": "slot", "slotId": "target1", "field": "altitude" }
        },
        {
          "id": "flight_line",
          "type": "line",
          "style": { "x": 10, "y": 80, "w": 580, "h": 210 },
          "props": {
            "xAxisMode": "time",
            "lookbackUnit": "minute",
            "lookbackMinutes": 20,
            "series": [
              {
                "target": "slot",
                "slotId": "target1",
                "field": "altitude",
                "label": "高度",
                "yAxis": "left",
                "color": "#3BD5FF"
              },
              {
                "target": "slot",
                "slotId": "target1",
                "field": "speed",
                "label": "速度",
                "yAxis": "right",
                "color": "#FFCA57"
              }
            ]
          }
        }
      ]
    }
  ]
}
